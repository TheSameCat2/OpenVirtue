<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The pre-ADR-0008 WinForms/D3D11 host. Built only on Windows. Other hosts compile a
    stub so the solution still loads. Never extended; deleted once the GL host has
    replaced it (ADR-0008).
  -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsWindows>$([MSBuild]::IsOSPlatform('windows'))</IsWindows>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindows)' == 'true'">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindows)' != 'true'">
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsWindows)' == 'true'">
    <Compile Include="Program.cs" />
    <Compile Include="Camera.cs" />
    <Compile Include="LevelWindow.cs" />
    <ProjectReference Include="..\..\OpenVirtue.Engine\OpenVirtue.Engine.csproj" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindows)' != 'true'">
    <Compile Include="NotBuiltOnThisPlatform.cs" />
  </ItemGroup>

</Project>
